<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Neuroma</AssemblyName>
    <RootNamespace>Neuroma</RootNamespace>
    <Version>0.6.1</Version>
    <ApplicationIcon>..\..\assets\Neuroma.ico</ApplicationIcon>
    <Authors>d-b-w-gain</Authors>
    <Description>A fast, distraction-free EPUB reader for the terminal.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console.ImageSharp" Version="0.57.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\dropcaps\ascii\celtic-*.ans"
                      LogicalName="Neuroma.DropCaps.Ascii.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
